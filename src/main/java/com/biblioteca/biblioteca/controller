package com.biblioteca.biblioteca.controller;

import com.biblioteca.biblioteca.model.Estante;
import com.biblioteca.biblioteca.service.EstanteService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.List;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;



@RestController
@RequestMapping("/estante")
@CrossOrigin(origins = "*") // permite requisições do frontend

public class EstanteController{

    @Autowired // diz ao Spring para procurar automaticamente um objeto
    private EstanteService estanteService;

    @GetMapping //vai ser executado quando houver um GET para estante
    public List<Estante> listar() {
        return estanteService.listarEstante(); //busca os livros e devolver uma lista.
    }

    @PostMapping // vai ser executado quando houver um POST para estante
    public ResponseEntity<?> salvar(@RequestBody Estante livro){
        try{
            Estante novoLivro = estanteService.salvarLivro(livro);  // recebe os dados do livro enviados pelo frontend através do corpo (body) da requisição.
            return ResponseEntity.status(HttpStatus.CREATED).body(novoLivro);
        }catch (RuntimeException e) {
            return ResponseEntity.status(HttpStatus.BAD_REQUEST).body(e.getMessage());
        }
    }

    @DeleteMapping("/{id}")  //vai ser executado quando houver um DELETE para estante
    public ResponseEntity<Void> remover(@PathVariable Long id) { // PathVariable pega o {id} que veio na URLcoloca dentro da variável id.
    //ResponseEntity<Void> significa que a resposta não terá um conteúdo no corpo.
        estanteService.removerLivro(id);
        return ResponseEntity.noContent().build(); // foi realizada mas não retorna nada
    }
}